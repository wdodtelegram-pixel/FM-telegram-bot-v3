# Copy to Bot/.env (never commit the real file).

# From @BotFather: send /newbot. Shape is <digits>:<letters and digits>.
TELEGRAM_BOT_TOKEN=

# The SAME PostgreSQL database the web API uses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/building_defect_db

# Optional: timezone for dates and, later, scheduled digests.
TZ=UTC
