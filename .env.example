# Copy to .env (never commit the real file). Read by `docker compose` AND by a plain
# `python -m botapp.main` / `flask`-less local run.

# From @BotFather: send /newbot. Shape is <digits>:<letters and digits>.
TELEGRAM_BOT_TOKEN=

# --- Docker Compose -----------------------------------------------------------
# Signs website logins. Use a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# --- Running without Docker ---------------------------------------------------
# The PostgreSQL database the bot and the API share.
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/fm_control

# Timezone for "today" in the bot and the dashboard, e.g. Asia/Singapore.
TZ=UTC
